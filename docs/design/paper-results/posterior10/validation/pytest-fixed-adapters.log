definition = 'repository'

    @pytest.mark.parametrize("definition", SS10_DEFINITIONS)
    def test_ss10_finite_box_evidence_and_density(definition):
        model = build_model("ss10", definition)
        means, scales = ss10_parameters(definition)
        reference = reference_values("ss10", definition)
        # Independent SciPy multivariate CDF at zero correlation, with finite bounds.
        masses = np.array([
            multivariate_normal.cdf(np.full(10, 8.), mean=mean,
                                    cov=scale ** 2 * np.eye(10),
                                    lower_limit=np.full(10, -4.))
            for mean, scale in zip(means, scales, strict=True)
        ])
        np.testing.assert_allclose(reference["log_Z"], np.log(masses.sum() / 12. ** 10),
                                   atol=1e-10, rtol=0)
        np.testing.assert_allclose(reference["spike_mass"], masses[0] / masses.sum(),
                                   atol=1e-10, rtol=0)
        u = model.sample_U(jax.random.PRNGKey(30))
        u = jax.tree.map(lambda value: jnp.asarray((means[0] + 4.) / 12.), u)
        expected = np.logaddexp(*[
            multivariate_normal.logpdf(means[0], mean=mean, cov=scale ** 2 * np.eye(10))
            for mean, scale in zip(means, scales, strict=True)
        ])
>       np.testing.assert_allclose(model.log_likelihood(u), expected, rtol=1e-12)
