_____ test_mixed_phantom_run_classic_ess_matches_result_and_direct_weights _____

    def test_mixed_phantom_run_classic_ess_matches_result_and_direct_weights():
        model = build_model("rastrigin10")
        depth = DepthCondition(dlogZ=jnp.log1p(.01))
        sampler = NestedSampler(
            model=model, root_allocation_degree=8, shell_size=4, delta_K=8,
            sampler=UniDimSliceSampler(model=model, num_slices=5,
                                       collect_phantom_samples=True,
                                       max_phantom_samples=4, no_step_out=True),
            collect_phantom_samples=True, max_phantom_samples=4,
            allocation_target="weighted", allocation_weights=AllocationWeights(.1, .9),
            unlimited_samples=True, depth_condition=depth,
        )
        bootstrap = dataclasses.replace(sampler, allocation_target="uniform",
                                        allocation_weights=None, delta_K=1)
